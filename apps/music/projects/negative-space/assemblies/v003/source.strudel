// Module 1: modules/v003/setup.strudel
// Negative Space — 128 BPM, 16 bars / 30 seconds, including release.
setcpm(128/4)
const nsOn = "<1!14 0!2>"
const nsKick = "<1!8 0 [1 0 1 0] 1!4 [1 0 0 0] 0>"
const nsTop = "<0!2 1!6 0!2 1!4 0!2>"
const nsBass = "<[~ f1 ~ f1 ~ ~ f1 ~ ~ f1 ~ ~ f1 ~ eb1 ~]!2 [~ f1 ~ ~ f1 ~ f1 ~ ~ f1 ~ ~ f1 ~ ~ f1]!2 [~ f1 ~ f1 ~ ~ f1 ~ ~ f1 ~ ~ f1 ~ eb1 ~]!2 [~ f1 ~ ~ ~ f1 ~ f1 ~ ~ f1 ~ f1 ~ ~ ~] [~ f1 ~ ~ f1 ~ f1 ~ ~ f1 ~ ~ ~ f1 f1 ~] [f1 ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ f1] [~ f1 ~ ~ f1 ~ f1 ~ ~ f1 ~ ~ f1 ~ ~ f1]!2 [~ f1 ~ f1 ~ ~ f1 ~ ~ f1 ~ ~ f1 ~ eb1 ~] [~ f1 ~ ~ ~ f1 ~ f1 ~ ~ f1 ~ ~ f1 ~ ~] ~!2>"

;

// Module 2: modules/v003/drums.strudel
kick: s("<[bd ~ ~ ~ bd ~ ~ ~ bd ~ ~ bd ~ ~ bd ~]!3 [bd ~ ~ ~ bd ~ ~ ~ bd ~ ~ ~ ~ bd ~ ~]>").bank("RolandTR909").speed(.84).gain(.48).orbit(1).mask(nsKick).postgain(.80)
clap: s("~ cp ~ cp").bank("RolandTR909").speed(.83).gain(.21).hpf(650).room(.06).orbit(2).mask(nsTop).postgain(.80)
hats: s("<[~ hh ~ hh ~ hh [hh hh] hh] [~ hh ~ [hh ~] ~ hh hh ~]>").bank("RolandTR909").gain(".075 .11 .07 .09").hpf(4100).pan(.59).swingBy(.07,8).orbit(1).mask(nsTop).postgain(.80)
openhat: s("~ ~ oh ~ ~ ~ oh ~").bank("RolandTR909").gain(.07).clip(.55).hpf(4300).pan(.33).orbit(1).mask("<0!4 1!4 0!2 1!4 0!2>").postgain(.80)
spring: s("<[~ ~ ~ nsspring ~ ~ ~ ~ ~ ~ nsspring ~ ~ ~ ~ ~] [~ ~ nsspring ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ nsspring ~ ~]>").speed(".82 1.11 .73").gain(".17 .11 .14").hpf(500).pan(".30 .68").swingBy(.13,8).room(.15).delay(.12).delaytime(.234375).delayfeedback(.24).orbit(3).mask("<0 1!7 0!2 1!4 0!2>").postgain(.80)

;

// Module 3: modules/v003/bass.strudel
sub: note(nsBass).s("sine").fm(.65).fmh(1).fmdecay(.075).fmsustain(.12).lpf(150).attack(.004).decay(.13).sustain(.5).release(.025).gain(.82).orbit(4).postgain(.80)
bass: note(nsBass).s("sawtooth").lpf("<340!2 420!2 520!2 390 650 200!2 520!2 700 360 200!2>").lpenv(1.8).lpattack(.002).lpdecay(.10).lpsustain(.12).attack(.004).decay(.13).sustain(.3).release(.025).gain(.48).orbit(4).postgain(.80)
servo: s("<[~ ~ ~ ~ ~ ~ nsservo ~] ~ [~ ~ ~ nsservo ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ nsservo]>").gain(.34).speed("<.8 .66 .88 .72>").lpf(1400).hpf(170).pan(.47).room(.10).orbit(5).mask("<1!8 0!2 1!4 0!2>").postgain(.80)

;

// Module 4: modules/v003/dub.strudel
dub: s("<[~ ~ ~ nschord ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ nschord ~] [~ nschord ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ nschord ~]>").speed("<.75 .75 .75 .75>").gain("<.34!4 .40!4 .46!2 .36!4 0!2>").lpf("<1800 1000 1450 700>").hpf(430).pan(.35).delay(.48).delaytime(.3515625).delayfeedback(.55).room(.42).roomsize(5).orbit(6).mask("<1!9 0 1 0 1 0 0!2>").postgain(.80)
dubecho: s("<[~ ~ ~ nschord ~ ~ ~ ~] ~ [~ nschord ~ ~ ~ ~ ~ ~] ~>").late(.09375).speed(.375).gain(.19).hpf(650).lpf(1450).distort("1.2:.3").pan(.69).delay(.48).delaytime(.234375).delayfeedback(.48).room(.28).orbit(7).mask("<1!8 1 0 1!4 0!2>").postgain(.80)
friction: s("nsfriction").slice(8,"<0 ~ 3 ~ 6 ~ 2 ~>").gain(.15).speed("<1 .75 1.2 .8>").hpf(1800).pan(".32 .64").delay(.17).delaytime(.1171875).delayfeedback(.27).room(.25).orbit(8).mask("<0!4 1!4 0!2 1!4 0!2>").postgain(.80)

ghost: s("nsghost").slice(4,"0 ~ 2 ~ ~ 1 ~ 3").gain(.30).lpf("1400 2100 900 1800").hpf(600).pan(".28 .65 .42 .72").delay(.13).delaytime(.17578125).delayfeedback(.22).room(.18).orbit(12).mask("<0!11 1 0 1 0!2>").postgain(.80)

;

// Module 5: modules/v003/edits.strudel
turnaround: s("~ ~ ~ ~ ~ ~ ~ ~ ~ ~ nsspring ~ nsservo ~ [nsspring nsspring] ~").gain(".09 .13 .1 .07").speed(.83).hpf(750).pan(".3 .7").orbit(9).mask("<0!3 1 0!3 1 0!5 1 0!2>").postgain(.80)
reverse: s("~ ~ ~ nsreverse").gain(.22).hpf(500).pan(.6).room(.2).orbit(10).mask("<0!7 1 0 1 0!3 1 0!2>").postgain(.80)
landing: s("nslanding").gain(.31).orbit(1).mask("<0!14 1 0>").postgain(.80)
lastchord: s("nschord").speed(.75).gain(.22).hpf(350).lpf(1250).pan(.42).delay(.45).delaytime(.3515625).delayfeedback(.50).room(.5).roomsize(5).orbit(11).mask("<0!14 1 0>").postgain(.80)

;

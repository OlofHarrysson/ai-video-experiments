// A five-sixteenth metallic phrase runs against 4/4, then is interrupted at phrase ends.
chain: s("prchain:0 ~ ~ prchain:2 ~").fast(16/5).gain(".095 .14 .11 .08 .15").speed("<.76 .82 .70 .86>").hpf(850).pan(".25 .72 .4").delay(.14).delaytime(.165441).delayfeedback(.22).room(.13).orbit(3).mask("<1!4 0 1!2 [1 1 0 0] 1!3 [1 1 0 0] 1!3 [1 0 0 0] 0>")
knock: s("<[~ ~ ~ ~ ~ ~ prknock:0 ~ ~ ~ ~ ~ ~ prknock:1 ~ ~] [~ ~ ~ prknock:1 ~ ~ ~ ~ ~ ~ prknock:2 ~ ~ ~ ~ ~]>").gain(".12 .17 .13 .16").hpf(180).pan(.43).room(.08).orbit(3).mask(live)
ghost: s("<[~ ~ ~ ~ ~ ~ ~ ~ ~ ~ prknock:1 ~ ~ ~ ~ prchain:1] [~ ~ ~ ~ ~ prchain:2 ~ ~ ~ ~ ~ ~ ~ ~ prknock:2 ~]>").speed(1.45).gain(.065).hpf(480).pan(.73).orbit(3).mask(topGate)
fill: s("~ ~ ~ ~ ~ ~ ~ ~ prchain:0 ~ prknock:0 prchain:2 prknock:1 [prchain:0 prchain:2] ~ ~").gain(".11 .12 .15 .09").hpf(320).speed("1 .83 1.12 .75").pan(".28 .69").orbit(3).mask("<0!3 1 0!3 1 0!3 1 0!3 1 0>")

bass: note(bassLine).s("sawtooth").lpf("<340 380 400 430 210 380 450 340 540 500 580 400 590 520 620 360 200>").lpenv(1.75).lpattack(.002).lpdecay(.10).lpsustain(.12).attack(.004).decay(.13).sustain(.30).release(.025).gain(.39).orbit(4).mask(bassGate)
rubber: s("<[~ ~ ~ prrubber:0 ~ ~ prrubber:1 ~ ~ ~ ~ prrubber:0 ~ ~ prrubber:2 ~] [~ ~ prrubber:0 ~ ~ ~ prrubber:1 ~ ~ ~ ~ prrubber:3 ~ ~ ~ ~]>").gain("<.20!4 .25!4 .30!4 .27!4 0>").hpf(180).lpf(1900).pan(".42 .58").delay(.17).delaytime(.110294).delayfeedback(.16).orbit(5).mask("<1!6 [1 1 0 0] 0!10>")
lowgrowl: note("f2").struct("<~ [~ x ~ ~ ~ ~ x ~] ~ [~ ~ ~ x ~ ~ x ~]>").s("supersaw").unison(3).detune(.13).spread(.25).lpf(260).lpenv(1.5).lpdecay(.10).attack(.008).decay(.13).sustain(.05).release(.05).gain(.18).orbit(4).mask(bassGate)



transformsub: note("f1").struct("x ~ ~ x ~").fast(16/5).clip(1.35).s("sine").attack(.004).decay(.13).sustain(.3).release(.035).lpf(120).gain(.57).orbit(4).mask("<0!6 [0 0 1 1] [1 1 1 0] 0!9>")


;

// Module 4: modules/percussion-v008.strudel
// The identical five-step rhythm is played through one shared resonator family.
object: s("<[prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0] [~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~] [~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~] [prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0 ~ prmorph:0 ~ ~ prmorph:0] [~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~] [prmorph:0 ~ ~ prmorph:1 ~ prmorph:2 ~ ~ prmorph:3 ~ prmorph:4 ~ ~ prmorph:5 ~ prmorph:5] [~ ~ prmorph:6 ~ prmorph:7 ~ ~ prmorph:8 ~ prmorph:9 ~ ~ prmorph:9 ~ prmorph:9 ~] [~ prmorph:10 ~ prmorph:10 ~ ~ prmorph:11 ~ prmorph:11 ~ ~ prmorph:12 ~ ~ ~ ~] [prmorph:12 ~ prmorph:11 ~ ~ prmorph:10 ~ prmorph:9 ~ ~ prmorph:7 ~ prmorph:6 ~ ~ prmorph:5] [~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~] [prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3] [~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ ~ ~ ~ prmorph:3 ~ prmorph:3 ~] [~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~] [prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3] [~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~ prmorph:3 ~ ~ prmorph:3 ~] [prmorph:3 ~ ~ prmorph:3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~]>").gain("<.25!5 .30 .40 .47 .39 .32!6 .28 0>").hpf(130).lpf(3300).clip("<.9!5 1.1 1.7 2 1.5 1.1!7 0>").pan(".40 .60").delay(.12).delaytime(.165441).delayfeedback(.18).room(.06).orbit(9)
knock: s("<[~ ~ ~ ~ ~ ~ prknock:0 ~ ~ ~ ~ ~ ~ prknock:1 ~ ~] [~ ~ ~ prknock:1 ~ ~ ~ ~ ~ ~ prknock:2 ~ ~ ~ ~ ~]>").gain(".16 .22 .18 .21").hpf(130).pan(.43).room(.08).orbit(3).mask("<1!6 0!2 1!8 0>")
ghost: s("<[~ ~ ~ ~ ~ ~ ~ ~ ~ ~ prknock:1 ~ ~ ~ ~ prchain:1] [~ ~ ~ ~ ~ prchain:2 ~ ~ ~ ~ ~ ~ ~ ~ prknock:2 ~]>").speed(1.45).gain(.075).hpf(480).pan(.73).orbit(3).mask("<1!4 0!4 1!3 [1 1 0 0] 0!5>")
fill: s("~ ~ ~ ~ ~ ~ ~ ~ prchain:0 ~ prknock:0 prchain:2 prknock:1 [prchain:0 prchain:2] ~ ~").gain(".11 .12 .15 .09").hpf(320).speed("1 .83 1.12 .75").pan(".28 .69").orbit(3).mask("<0!3 1 0!7 1 0!5>")

exitclick: s("~ ~ prchain:3 [prchain:1 ~ prchain:0 ~]").speed(.71).hpf(750).gain(.16).pan(".25 .7").delay(.32).delaytime(.220588).delayfeedback(.36).orbit(3).mask("<0!15 1 0>")

ratchet: s("~ ~ ~ [prchain:1 prchain:2 prknock:1 prchain:0 ~ ~ ~ ~]").speed(.75).hpf(380).lpf(2500).gain(".19 .16 .13 .11").pan(".34 .66").delay(.12).delaytime(.055147).delayfeedback(.20).orbit(8).mask("<0!7 1 0!9>")

;


{
  "dependencies": {
    "@strudel/web": "1.3.0",
    "acorn": "8.19.0",
    "playwright-core": "1.64.0"
  },
  "name": "music-workbench-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test renderer/*.test.mjs",
    "postinstall": "node renderer/apply-patch.mjs",
    "test:player": "node --test player/*.test.mjs",
    "design:before": "node player/design/validate.mjs before",
    "design:validate": "node player/design/validate.mjs after",
    "design:review": "node tools/design-harness/modules/review/build.mjs player/design/review.json player/design/review.html"
  },
  "engines": {
    "node": ">=20"
  }
}
